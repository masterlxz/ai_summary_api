{
  "manifest_version": 3,
  "name": "Gemini Summarizer",
  "version": "1.0",
  "description": "Resume o conteúdo da página atual usando Gemini e Rails.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "oauth2": {
    "client_id": "91148707774-hucvtf52i8t66mo79n3l6jke8981178l.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "action": {
    "default_popup": "popup.html"
  }
}
